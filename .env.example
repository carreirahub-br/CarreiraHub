APP_ENV=development
APP_DEBUG=true
APP_NAME=CarreiraHub
APP_BASE_URL=http://localhost:8000
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=sqlite+pysqlite:///./carreirahub.db
# DATABASE_URL=postgresql+psycopg://carreirahub:change-me@localhost:5432/carreirahub
# No Render, DATABASE_URL é injetada pelo Blueprint (postgres:// é convertida automaticamente).
AUTO_CREATE_TABLES=true
# Em produção no Render: AUTO_CREATE_TABLES=false (as tabelas vêm do Alembic).
ADSENSE_ENABLED=false
ADSENSE_CLIENT_ID=
SOCIAL_LINKEDIN_URL=
SOCIAL_INSTAGRAM_URL=
SOCIAL_YOUTUBE_URL=
CONTACT_EMAIL=contato@carreirahub.com.br
